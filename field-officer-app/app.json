{
  "expo": {
    "name": "field-officer-app",
    "slug": "field-officer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.fieldofficerapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to measure granite blocks using AR and to capture inspection photographs.",
        "NSLocalNetworkUsageDescription": "This app connects to the Django backend server on your local network to submit block inspections.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.fieldofficerapp",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
